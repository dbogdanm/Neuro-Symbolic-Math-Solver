# Copy to `.env` and adjust. Every value is optional — sane defaults apply.

# --- Server ---
PORT=5000
# Enables the Flask debugger/reloader. Set to 1 only for local development.
FLASK_DEBUG=0

# --- Local Ollama (default provider, no API key required) ---
OLLAMA_URL=http://localhost:11434
MODEL_8B=deepseek-r1:8b

# --- Optional server-side fallback keys ---------------------------------------
# BYOK keys sent from the browser always take precedence over these. Provide a
# key here only if you want the server to have a default for a given provider.
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_REFERER=http://localhost:5000
