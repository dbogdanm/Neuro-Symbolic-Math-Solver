# ── Math-OS environment (all optional) ───────────────────────────────────────
# Copy to `.env`. Every value has a sane default; nothing here is required to
# run locally with Ollama.

# Local Ollama server (used when provider = ollama)
OLLAMA_URL=http://localhost:11434
MODEL_8B=deepseek-r1:8b

# OpenRouter (Bring Your Own Key). Users normally enter their key in the UI,
# where it stays in their browser. Set this ONLY if you want the server to
# provide a default fallback key for everyone (not recommended for public deploys).
# OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-r1
# Shown to OpenRouter for attribution / app rankings.
OPENROUTER_REFERER=http://localhost:5000

# Flask
FLASK_DEBUG=1
PORT=5000
